POSTGRES_DB=llm_grader
POSTGRES_USER=llm_grader
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
ARTIFACT_ROOT=/data/artifacts
LLM_GRADER_COOKIE_SECURE=false
LLM_GRADER_ALLOW_HEADER_AUTH=false
STUDENT_PORTAL_ENABLED=false
LLM_GRADER_LLM_MODEL_ID=local-text-model
LLM_GRADER_LLM_MODEL_PATH=/models/model.gguf
LLM_GRADER_MODEL_ANSWER_CLASSIFIER_PROFILE=ornith_rubric_draft
# Optional host directory instead of the llm_models named volume:
# LLM_MODELS_DIR=/srv/llm-grader/models
# LLM_GRADER_RUNTIME_CONFIG_FILE=./config/runtime.deployment.json
# LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b9265

LLM_GRADER_RUNTIME_BACKEND=auto
# Optional installed ROCm wrapper in a custom runtime image:
# LLM_GRADER_ROCM_BINARY=/opt/llama/rocm/llama-server
