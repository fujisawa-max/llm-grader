FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./alembic.ini
RUN pip install .

RUN mkdir -p /data/artifacts /data/artifacts/question-imports
EXPOSE 8000
CMD ["uvicorn", "scoring.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
