FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ARG API_PROXY_TARGET=http://api:8000
ARG API_PROXY_TIMEOUT_MS=900000
ENV API_PROXY_TARGET=${API_PROXY_TARGET} API_PROXY_TIMEOUT_MS=${API_PROXY_TIMEOUT_MS}
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ARG API_PROXY_TIMEOUT_MS=900000
ENV NODE_ENV=production API_PROXY_TIMEOUT_MS=${API_PROXY_TIMEOUT_MS}
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
