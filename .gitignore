# 答案・問題・採点結果はローカル管理。共有用テンプレートのみ追跡する。
/data/*
!/data/.gitkeep
/runs/*
!/runs/.gitkeep
/config/local.json
.env
.env.*
!.env.example
*.gguf
__pycache__/
.venv/

/testData/
/imported-conversation.md
/docs/auto-grading-system-spec-v4.md
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/npm-debug.log*
frontend/test-results/
# Local model weights and runtime caches (often tens of GB).
*.gguf
*.safetensors
*.bin
/.cache/
/models/

# Private source material and generated reports.
/data/assignments/
/data/evaluation/
/reports/
*.raw.json
*.core

# Local credentials and editor/OS files.
.hf_token
*.pem
.DS_Store
*.swp
*.pid
.coverage
coverage.xml
htmlcov/
.pytest_cache/
dist/
build/
*.egg-info/
.ruff_cache/

# Local databases / backups
*.db
*.sqlite
*.sqlite3
*.dump

# Runtime/generated files
/artifacts/
runtime-*.log

# OAuth callback remnants
callback?code=*

# Local credentials / secrets
.env
.env.local
.env.*.local
data/operations/**/owner-credentials.json
data/operations/**/*credentials*.json

student-answer/
student-visual/

*.tsbuildinfo

# Local-only Codex development environment. Never commit these files.
/AGENTS.md
/.agents/
/.codex/
/.env.dev
/.env.dev.*
/Dockerfile.codex
/compose.dev.yaml
/docker/codex/
/docs/operations/codex-container-development.md
/scripts/codex-dev-entrypoint.sh
/scripts/dev-codex.sh
