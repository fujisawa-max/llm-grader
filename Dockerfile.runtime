# All builds are independent of deployment hardware. Isolated binary directories
# prevent a failed GPU shared library from breaking the CPU executable.
ARG LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b9265
ARG LLAMA_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b9265
FROM ${LLAMA_CUDA_IMAGE} AS cuda

FROM ubuntu:24.04 AS vulkan-build
ARG LLAMA_CPP_REF=b9265
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git cmake build-essential libssl-dev libvulkan-dev glslc \
    spirv-headers glslang-tools \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git /src
RUN cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
    -DGGML_NATIVE=OFF -DGGML_VULKAN=ON -DGGML_BACKEND_DL=ON \
    -DGGML_CPU_ALL_VARIANTS=ON -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_TOOLS=ON \
    && cmake --build /build --target llama-server -j2 \
    && mkdir /out && cp /build/bin/llama-server /out/ \
    && find /build -name '*.so*' -exec cp -P '{}' /out/ ';'

FROM ${LLAMA_SERVER_IMAGE}
USER root
COPY --from=cuda /app/ /opt/llama/cuda/
# CUDA runtime libraries, not the host driver (injected by NVIDIA Toolkit).
COPY --from=cuda /usr/local/cuda-12.8/ /usr/local/cuda-12.8/
COPY --from=vulkan-build /out/ /opt/llama/vulkan/
RUN mkdir -p /opt/llama/cpu && cp -a /app/. /opt/llama/cpu/ \
    && apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
       libvulkan1 mesa-vulkan-drivers libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/runtime-venv
COPY scripts/llama-backend-entrypoint.sh /usr/local/libexec/llama-backend-entrypoint
RUN for backend in cpu cuda vulkan; do \
      mv /opt/llama/$backend/llama-server /opt/llama/$backend/llama-server.bin; \
      cp /usr/local/libexec/llama-backend-entrypoint /opt/llama/$backend/llama-server; \
      chmod 755 /opt/llama/$backend/llama-server; \
    done
ENV PATH=/opt/runtime-venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
WORKDIR /srv/llm-grader
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . \
    && groupadd --gid 10001 runtime \
    && useradd --uid 10001 --gid runtime --no-create-home runtime \
    && mkdir -p /models /runtime-state /etc/llm-grader \
    && chown runtime:runtime /models /runtime-state
COPY config/runtime.deployment.json /etc/llm-grader/runtime.json
USER runtime
WORKDIR /runtime-state
HEALTHCHECK NONE
ENTRYPOINT ["python", "-m", "scoring.runtime.server"]
