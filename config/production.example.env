# Copy to a deployment-managed environment file; do not commit real secrets.
LLM_GRADER_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/DB_NAME
LLM_GRADER_ALLOWED_ROOTS=/srv/llm-grader/artifacts:/srv/llm-grader/runs
LLM_GRADER_ARTIFACT_ROOT=/srv/llm-grader/artifacts
LLM_GRADER_CORS_ORIGINS=http://127.0.0.1:3001
# Browser authentication uses a revocable HttpOnly cookie.  Keep header auth
# disabled unless an explicitly isolated auth proxy requires it.
LLM_GRADER_ALLOW_HEADER_AUTH=false
LLM_GRADER_SESSION_TTL_SECONDS=28800
LLM_GRADER_COOKIE_SECURE=true
LLM_GRADER_RUNTIME_MANAGER_URL=http://127.0.0.1:18080
LLM_GRADER_GRADING_CONFIG=/srv/llm-grader/config/grading.json
STUDENT_PORTAL_ENABLED=false
LLM_GRADER_LOG_LEVEL=INFO
LLM_GRADER_LOG_RETENTION_DAYS=30
LLM_GRADER_WORKER_PID_FILE=/run/llm-grader/worker.pid
LLM_GRADER_BACKUP_ROOT=/srv/backups/llm-grader
FRONTEND_PORT=3001
BACKEND_PORT=8000
