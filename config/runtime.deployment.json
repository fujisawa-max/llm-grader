{
  "schema_version": 2,
  "model_definitions": {
    "default_text": {
      "model_id": "${LLM_GRADER_LLM_MODEL_ID:-local-text-model}",
      "model_path": "${LLM_GRADER_LLM_MODEL_PATH:-/models/model.gguf}",
      "vision": false,
      "capabilities": [
        "text",
        "structured_output"
      ]
    },
    "unimumer": {
      "model_id": "${LLM_GRADER_MATH_MODEL_ID:-unimumer-q4}",
      "model_path": "${LLM_GRADER_MATH_MODEL_PATH:-/models/math-ocr.gguf}",
      "mmproj_path": "${LLM_GRADER_MATH_MMPROJ_PATH:-/models/math-ocr-mmproj.gguf}",
      "vision": true,
      "capabilities": [
        "vision",
        "math_ocr"
      ]
    },
    "ricoh": {
      "model_id": "${LLM_GRADER_OCR_MODEL_ID:-ricoh-8b}",
      "model_path": "${LLM_GRADER_OCR_MODEL_PATH:-/models/Qwen-3-VL-Ricoh-8B-20260227-Q8_0.gguf}",
      "mmproj_path": "${LLM_GRADER_OCR_MMPROJ_PATH:-/models/Qwen-3-VL-Ricoh-8B-20260227-mmproj-f16.gguf}",
      "vision": true,
      "capabilities": [
        "vision",
        "region_grouping"
      ]
    }
  },
  "runtime_defaults": {
    "runtime_type": "managed",
    "server_binary": "${LLM_GRADER_LLAMA_SERVER_BINARY:-/app/llama-server}",
    "host": "0.0.0.0",
    "advertise_host": "${LLM_GRADER_RUNTIME_ADVERTISE_HOST:-runtime-manager}",
    "startup_timeout_seconds": 300,
    "context_size": 8192,
    "gpu_layers": "auto",
    "backend": "${LLM_GRADER_RUNTIME_BACKEND:-auto}"
  },
  "profiles": {
    "grader": {
      "model_ref": "default_text",
      "purpose": "grading",
      "log_path": "/runtime-state/grader.log"
    },
    "ornith_rubric_draft": {
      "model_ref": "default_text",
      "purpose": "model_answer_classifier",
      "log_path": "/runtime-state/model-answer-classifier.log",
      "request_timeout_seconds": 300,
      "generation": {
        "max_output_tokens": 512
      },
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    },
    "math_ocr": {
      "model_ref": "unimumer",
      "purpose": "math_ocr",
      "port": 8082,
      "log_path": "/runtime-state/math-ocr.log",
      "request_timeout_seconds": 300,
      "generation": {
        "temperature": 0,
        "max_output_tokens": 2048
      }
    },
    "ocr": {
      "model_ref": "ricoh",
      "purpose": "math_region_grouping",
      "port": 8081,
      "log_path": "/runtime-state/math-grouping.log",
      "request_timeout_seconds": 300,
      "generation": {
        "temperature": 0,
        "max_output_tokens": 1024
      },
      "chat_template_kwargs": {
        "enable_thinking": false
      }
    }
  },
  "runtime_backends": {
    "cpu": "${LLM_GRADER_CPU_BINARY:-/opt/llama/cpu/llama-server}",
    "cuda": "${LLM_GRADER_CUDA_BINARY:-/opt/llama/cuda/llama-server}",
    "rocm": "${LLM_GRADER_ROCM_BINARY:-}",
    "vulkan": "${LLM_GRADER_VULKAN_BINARY:-/opt/llama/vulkan/llama-server}"
  }
}
